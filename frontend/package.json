{
  "name": "parvaah",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "npm --prefix ../backend run dev",
    "server:start": "npm --prefix ../backend run start",
    "server:build": "npm --prefix ../backend run build",
    "server:test": "npm --prefix ../backend test",
    "dev:all": "npx concurrently \"npm run dev\" \"npm run server\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.43.0",
    "maplibre-gl": "^6.9.0",
    "mongoose": "^9.9.5",
    "parvaah-backend": "file:../backend",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "oxlint": "^1.85.0",
    "typescript": "~6.0.2",
    "vite": "^5.4.21"
  }
}
