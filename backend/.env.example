# ==============================================================================
# PARVAAH BACKEND PRODUCTION CONFIGURATION TEMPLATE
# Copy this file to .env for local development. Never commit real keys.
# ==============================================================================

# Core Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Data Mode: 'demo' | 'live' | 'hybrid'
DATA_MODE=demo

# IMD (India Meteorological Department) Integration Configuration
# Keep disabled unless official credentials and endpoint docs are provided
IMD_ENABLED=false
IMD_API_BASE_URL=
IMD_API_KEY=
IMD_API_TIMEOUT_MS=10000
IMD_POLL_INTERVAL_MINUTES=30

# Database & Cache (Optional in demo mode)
DATABASE_URL=
REDIS_URL=
